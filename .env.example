# ローカル開発用DB設定。
DB_USER=admin
DB_PASSWORD=admin
DB_NAME=syncnesto
DATABASE_URL=postgresql://admin:admin@localhost:5432/syncnesto

# アプリケーション実行設定。
APP_NAME=Syncnesto API
APP_ENV=development
# 本番はTerraformのbackend_bff_secretを設定し、実際のAPIホストを列挙する。
BFF_SHARED_SECRET=
ALLOWED_HOSTS=localhost,127.0.0.1

# ログ設定。
# LOG_FORMAT は "text" または "json" を指定する。
LOG_LEVEL=INFO
LOG_FORMAT=text
SLOW_REQUEST_THRESHOLD_MS=1000
SQL_ECHO=false

# JWT署名設定。
# 本番環境では十分に長いランダム値を設定する。
SECRET_KEY=change-me-at-least-32-bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# サーバー側セッション設定。
# SESSION_IDLE_TIMEOUT_MINUTES は無操作時のセッション期限を制御する。
# SESSION_REFRESH_THRESHOLD_MINUTES は sliding expiration の延長タイミングを制御する。
# SESSION_ABSOLUTE_TIMEOUT_MINUTES はログインからの最大セッション時間を制御する。
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_REFRESH_THRESHOLD_MINUTES=10
SESSION_ABSOLUTE_TIMEOUT_MINUTES=480

# ログイン試行制限設定。
# ロック中でも外向きのエラーは常に INVALID_CREDENTIALS を返す。
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# 監査ログ保持・削除設定。
# cleanupコマンドはAUDIT_LOG_CLEANUP_MIN_DAYS未満の削除を拒否する。
AUDIT_LOG_RETENTION_DAYS=1095
AUDIT_LOG_CLEANUP_MIN_DAYS=30

# 認証Cookie設定。
# 本番環境では AUTH_COOKIE_SECURE=true にする。
AUTH_COOKIE_NAME=access_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# CSRF対策設定。
# フロントエンド/BFF は csrf_token Cookie の値を X-CSRF-Token として送信する。
CSRF_COOKIE_NAME=csrf_token
CSRF_HEADER_NAME=X-CSRF-Token
CSRF_COOKIE_SECURE=false
CSRF_COOKIE_SAMESITE=lax

# 開発互換用の切り替え設定。
# Cookie-only認証を使う本番環境では通常どちらも false にする。
ALLOW_BEARER_TOKEN_RESPONSE=false
ALLOW_AUTHORIZATION_HEADER=false

# 初期システム管理者seed設定。
# 実環境で使う前に必ずパスワードを変更する。
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change-me
INITIAL_ADMIN_NAME=Initial Admin

# ユーザーアイコン用S3 / LocalStack設定。
# server は従来API、presigned はストレージへ直接PUTする。
FILE_UPLOAD_MODE=server
# 直接送信用URL・登録許可の有効期間（1〜3600秒）。
FILE_UPLOAD_URL_EXPIRES_SECONDS=600
# 本番AWSでは AWS_ENDPOINT_URL / AWS_S3_ENDPOINT_URL は未設定にする。
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=ap-northeast-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_S3_BUCKET_NAME=syncnesto-local-app-bucket
AWS_S3_PRESIGNED_URL_EXPIRES_SECONDS=3600
DEFAULT_AVATAR_KEY=default-avatar.png
