# ローカル開発用DB設定。
DB_USER=admin
DB_PASSWORD=admin
DB_NAME=syncnesto
DATABASE_URL=postgresql://admin:admin@localhost:5432/syncnesto

# アプリケーション実行設定。
APP_NAME=Syncnesto API
# development / test / production。公開デモもAPP_ENV=productionを使う。
APP_ENV=development
# デモの動作は実行環境と分離する。未設定時もfalse。
DEMO_MODE=false
# 通常のDATABASE_URL / AWS_* / SECRET_KEYは維持し、デモだけ専用設定を追加する。
DEMO_DATA_ISOLATED=false
DEMO_DATABASE_URL=
DEMO_SECRET_KEY=
DEMO_AWS_REGION=ap-southeast-1
DEMO_AWS_ACCESS_KEY_ID=
DEMO_AWS_SECRET_ACCESS_KEY=
DEMO_AWS_S3_BUCKET_NAME=syncnesto-demo
DEMO_AWS_S3_ENDPOINT_URL=
# 同じBackend Project内の回収Cron専用。JWT/BFFの鍵とは分ける。
CRON_SECRET=
# 本番はTerraformのbackend_bff_secretを設定し、実際のAPIホストを列挙する。
BFF_SHARED_SECRET=
ALLOWED_HOSTS=localhost,127.0.0.1

# ログ設定。
# LOG_FORMAT は "text" または "json" を指定する。
LOG_LEVEL=INFO
LOG_FORMAT=text
SLOW_REQUEST_THRESHOLD_MS=1000
SQL_ECHO=false

# JWT署名設定。
# 本番環境では十分に長いランダム値を設定する。
SECRET_KEY=change-me-at-least-32-bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# サーバー側セッション設定。
# SESSION_IDLE_TIMEOUT_MINUTES は無操作時のセッション期限を制御する。
# SESSION_REFRESH_THRESHOLD_MINUTES は sliding expiration の延長タイミングを制御する。
# SESSION_ABSOLUTE_TIMEOUT_MINUTES はログインからの最大セッション時間を制御する。
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_REFRESH_THRESHOLD_MINUTES=10
SESSION_ABSOLUTE_TIMEOUT_MINUTES=480

# ログイン試行制限設定。
# ロック中でも外向きのエラーは常に INVALID_CREDENTIALS を返す。
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# 監査ログ保持・削除設定。
# cleanupコマンドはAUDIT_LOG_CLEANUP_MIN_DAYS未満の削除を拒否する。
AUDIT_LOG_RETENTION_DAYS=1095
AUDIT_LOG_CLEANUP_MIN_DAYS=30

# ごみ箱の復元期限。0は期限なし。完全削除はcleanup_deleted_dataの明示実行のみ。
DELETED_DATA_RETENTION_DAYS=30
# 通常環境の定期回収。まずdry_runで対象確認し、executeは明示的に設定する。
DELETED_DATA_CLEANUP_MODE=disabled
DELETED_DATA_CLEANUP_TENANT_IDS=
DELETED_DATA_CLEANUP_LIMIT=20
DELETED_DATA_CLEANUP_BUDGET_SECONDS=20

# 認証Cookie設定。
# 本番環境では AUTH_COOKIE_SECURE=true にする。
AUTH_COOKIE_NAME=access_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# CSRF対策設定。
# フロントエンド/BFF は csrf_token Cookie の値を X-CSRF-Token として送信する。
CSRF_COOKIE_NAME=csrf_token
CSRF_HEADER_NAME=X-CSRF-Token
CSRF_COOKIE_SECURE=false
CSRF_COOKIE_SAMESITE=lax

# 開発互換用の切り替え設定。
# Cookie-only認証を使う本番環境では通常どちらも false にする。
ALLOW_BEARER_TOKEN_RESPONSE=false
ALLOW_AUTHORIZATION_HEADER=false

# 初期システム管理者seed設定。
# 実環境で使う前に必ずパスワードを変更する。
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change-me
INITIAL_ADMIN_NAME=Initial Admin

# メール本人確認。disabledは送信申請を503で拒否する（成功を偽装しない）。
# ローカル: infraのMailpit起動後にsmtpへ変更する。
# ドメイン購入なしの実送信: smtp.gmail.com:587 + STARTTLS + Gmailアプリパスワード。
# EMAIL_FROMのアドレスとSMTP_USERNAMEは同じGmailアドレスにする。
# 本番FRONTEND_PUBLIC_URLはHTTPS。設定手順はdocs/email-approval.mdを参照。
# 将来Resendへ切り替える場合は独自ドメインの認証とAPIキーを設定する。
EMAIL_PROVIDER=disabled
EMAIL_FROM=Syncnesto <noreply@syncnesto.local>
FRONTEND_PUBLIC_URL=http://localhost:3000
# Backend内のリモートMCP。初期状態では無効。通常DBを使用する。
MCP_ENABLED=false
MCP_ISSUER_URL=http://127.0.0.1:8000
MCP_RESOURCE_URL=http://127.0.0.1:8000/mcp
# OpenAIの管理画面で確認した正確なcallback URL。空ならHTTPS callbackを許可しない。
MCP_PLUGIN_REDIRECT_URIS=
EMAIL_TIMEOUT_SECONDS=10
ACCOUNT_ACTION_EXPIRE_SECONDS=1800
RESEND_API_KEY=
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=

# Gmailへ切り替えるときだけGit管理外.env/Backend環境変数に設定する例。
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_STARTTLS=true
# SMTP_USERNAME=your-sender@gmail.com
# SMTP_PASSWORD=<空白なし16文字のアプリパスワード。チャットやGitに貼らない>
# EMAIL_FROM=Syncnesto <your-sender@gmail.com>

# ユーザーアイコン用S3 / LocalStack設定。
# server は従来API、presigned はストレージへ直接PUTする。
FILE_UPLOAD_MODE=server
# 直接送信用URL・登録許可の有効期間（1〜3600秒）。
FILE_UPLOAD_URL_EXPIRES_SECONDS=600
# 本番AWSでは AWS_ENDPOINT_URL / AWS_S3_ENDPOINT_URL は未設定にする。
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=ap-northeast-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_S3_BUCKET_NAME=syncnesto-local-app-bucket
AWS_S3_PRESIGNED_URL_EXPIRES_SECONDS=3600
DEFAULT_AVATAR_KEY=default-avatar.png
